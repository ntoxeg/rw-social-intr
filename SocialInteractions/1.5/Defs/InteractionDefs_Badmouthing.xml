<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <InteractionDef>
    <defName>Badmouthing</defName>
    <label>badmouth someone</label>
    <workerClass>SocialInteractions.Interactions.InteractionWorker_Badmouthing</workerClass>
    <symbol>Things/Mote/SpeechSymbols/Insult</symbol>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] spoke negatively about someone to [RECIPIENT_nameDef]</li>
      </rulesStrings>
    </logRulesInitiator>
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameDef] heard negative comments from [INITIATOR_nameDef]</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

  <InteractionDef>
    <defName>EnhancedInsult</defName>
    <label>enhanced insult</label>
    <workerClass>SocialInteractions.Interactions.InteractionWorker_EnhancedInsult</workerClass>
    <symbol>Things/Mote/SpeechSymbols/Insult</symbol>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] insulted [RECIPIENT_nameDef].</li>
      </rulesStrings>
    </logRulesInitiator>
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameDef] was insulted by [INITIATOR_nameDef].</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

  <InteractionDef>
    <defName>LoversQuarrel</defName>
    <label>lover's quarrel</label>
    <workerClass>SocialInteractions.Interactions.InteractionWorker_LoversQuarrel</workerClass>
    <symbol>Things/Mote/SpeechSymbols/Insult</symbol>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] had a quarrel with [RECIPIENT_nameDef].</li>
        <li>r_logentry->[INITIATOR_nameDef] argued with [RECIPIENT_nameDef].</li>
      </rulesStrings>
    </logRulesInitiator>
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameDef] had a quarrel with [INITIATOR_nameDef].</li>
        <li>r_logentry->[RECIPIENT_nameDef] argued with [INITIATOR_nameDef].</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

  <InteractionDef>
    <defName>Admiration</defName>
    <label>admiration</label>
    <workerClass>SocialInteractions.Interactions.InteractionWorker_Admiration</workerClass>
    <symbol>Things/Mote/SpeechSymbols/Speech</symbol>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] expressed admiration for [RECIPIENT_nameDef].</li>
      </rulesStrings>
    </logRulesInitiator>
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameDef] received admiration from [INITIATOR_nameDef].</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

  <InteractionDef>
    <defName>Backstabbing</defName>
    <label>strategic backstabbing</label>
    <workerClass>SocialInteractions.Interactions.InteractionWorker_Backstabbing</workerClass>
    <symbol>Things/Mote/SpeechSymbols/Insult</symbol>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] attempted to manipulate [RECIPIENT_nameDef].</li>
      </rulesStrings>
    </logRulesInitiator>
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameDef] was approached by [INITIATOR_nameDef] with shady information about one of their friends.</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

  <InteractionDef>
    <defName>MakeUp</defName>
    <label>make up/apologizing</label>
    <workerClass>SocialInteractions.Interactions.InteractionWorker_MakeUp</workerClass>
    <symbol>Things/Mote/SpeechSymbols/Speech</symbol>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] tried to make up with [RECIPIENT_nameDef]</li>
        <li>r_logentry->[INITIATOR_nameDef] attempted to reconcile with [RECIPIENT_nameDef]</li>
        <li>r_logentry->[INITIATOR_nameDef] sought forgiveness from [RECIPIENT_nameDef]</li>
        <li>r_logentry->[INITIATOR_nameDef] tried to apologize to [RECIPIENT_nameDef]</li>
      </rulesStrings>
    </logRulesInitiator>
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameDef] received an apology from [INITIATOR_nameDef]</li>
        <li>r_logentry->[RECIPIENT_nameDef] was approached by [INITIATOR_nameDef] for reconciliation</li>
        <li>r_logentry->[RECIPIENT_nameDef] was asked for forgiveness by [INITIATOR_nameDef]</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

</Defs>