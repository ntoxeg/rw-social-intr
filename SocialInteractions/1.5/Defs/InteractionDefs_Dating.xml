<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  

  <ThoughtDef>
    <defName>CaughtCheating</defName>
    <thoughtClass>SocialInteractions.Dating.Thought_CaughtCheating</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>Caught {0} cheating</label>
        <description>I can't believe I saw them with my own eyes...</description>
        <baseMoodEffect>-25</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>GotCaughtCheating</defName>
    <thoughtClass>SocialInteractions.Dating.Thought_GotCaughtCheating</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>Got caught cheating by {0}</label>
        <description>I've been caught red-handed...</description>
        <baseMoodEffect>-15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>WasCheatedOn</defName>
    <thoughtClass>SocialInteractions.Dating.Thought_WasCheatedOn</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>Was cheated on by {0}</label>
        <description>Should have been more careful...</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <InteractionDef>
    <defName>CaughtCheating</defName>
    <label>caught cheating</label>
    <workerClass>SocialInteractions.Interactions.InteractionWorker_CaughtCheating</workerClass>
    <symbol>Things/Mote/SpeechSymbols/Insult</symbol>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] caught [RECIPIENT_nameDef] cheating.</li>
      </rulesStrings>
    </logRulesInitiator>
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameDef] was caught cheating by [INITIATOR_nameDef].</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

  <InteractionDef>
    <defName>DateLovin</defName>
    <label>lovin'</label>
    <workerClass>SocialInteractions.Interactions.InteractionWorker_DateLovin</workerClass>
    <symbol>Things/Mote/SpeechSymbols/Romance</symbol>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] ended a date with [RECIPIENT_nameDef] in a special way.</li>
      </rulesStrings>
    </logRulesInitiator>
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameDef] ended a date with [INITIATOR_nameDef] in a special way.</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

</Defs>